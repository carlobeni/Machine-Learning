      "source": [
        "from sklearn.compose import ColumnTransformer\n",
        "from sklearn.pipeline import Pipeline\n",
        "from sklearn.preprocessing import StandardScaler, OneHotEncoder\n",
        "from sklearn.impute import SimpleImputer\n",
        "\n",
        "# [COMPLETAR] Crear ColumnTransformer completo\n",
        "preprocessor = ColumnTransformer([\n",
        "    ('num', Pipeline([\n",
        "        ('imputer', None),  # Reemplazar None\n",
        "        ('scaler', None)    # Reemplazar None\n",
        "    ]), num_features),\n",
        "    ('cat', Pipeline([\n",
        "        ('imputer', None),  # Reemplazar None\n",
        "        ('encoder', None)   # Reemplazar None\n",
        "    ]), ['Neighborhood', 'HouseStyle'])\n",
        "])\n",
        "\n",
        "# [COMPLETAR] Crear pipeline\n",
        "pipeline = Pipeline([\n",
        "    ('preprocessor', preprocessor)\n",
        "])\n",
        "\n",
        "# Aplicar pipeline\n",
        "X_processed = pipeline.fit_transform(ames_sim)\n",
