      "source": [
        "from sklearn.preprocessing import StandardScaler, MinMaxScaler\n",
        "\n",
        "# Datos de ejemplo con diferentes escalas\n",
        "np.random.seed(42)\n",
        "data_escalas = {\n",
        "    'edad': np.random.randint(18, 70, 100),\n",
        "    'ingreso': np.random.randint(20000, 150000, 100),\n",
        "    'puntuacion': np.random.randint(1, 100, 100)\n",
        "}\n",
        "df_escalas = pd.DataFrame(data_escalas)\n",
        "\n",
        "print(\"Datos originales - Estadisticas:\")\n",
        "print(df_escalas.describe())\n",
        "\n",
        "# [COMPLETAR] Aplicar StandardScaler\n",
        "scaler = StandardScaler().fit(df_escalas.values)  # Reemplazar None con el codigo correcto\n",
        "df_stand =pd.DataFrame(scaler.transform(df_escalas.values))   # Reemplazar None con el codigo correcto\n",
        "\n",
        "print(\"\\nDatos estandarizados - Estadisticas:\")\n",
        "print(df_stand.describe())\n",
        "\n",
        "# [COMPLETAR] Aplicar MinMaxScaler\n",
        "minmax_scaler = MinMaxScaler().fit(df_escalas.values)  # Reemplazar None con el codigo correcto\n",
        "df_minmax =pd.DataFrame(minmax_scaler.transform(df_escalas.values))  # Reemplazar None con el codigo correcto\n",
        "\n",
        "#print(\"\\nDatos normalizados - Estadisticas:\")\n",
        "print(df_minmax.describe())"
      ]
    },
